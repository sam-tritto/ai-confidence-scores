# Provider Toggle (true = Vertex AI, false = AI Studio API Key)
USE_VERTEX_AI=true

# -----------------------------------------------------------------------------
# Vertex AI Configuration (Used when USE_VERTEX_AI=true)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=gemini-sandbox-446215
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_LLM_JUDGE_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Google AI Studio API Key Configuration (Used when USE_VERTEX_AI=false)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY_GEMINI_MODEL=gemini-2.5-flash
API_KEY_LLM_JUDGE_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Routing & Audit Configuration
# -----------------------------------------------------------------------------
AUDIT_CONFIDENCE_THRESHOLD=0.75
LOG_LEVEL=INFO
